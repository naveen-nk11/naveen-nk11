<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 140" width="800" height="140">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000000"/>
      <stop offset="0.6" stop-color="#0f2027"/>
      <stop offset="1" stop-color="#203a43"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff9c4" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#fff9c4" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="800" height="140" rx="12" fill="url(#sky)"/>

  <!-- moon -->
  <circle cx="700" cy="45" r="46" fill="url(#glow)"/>
  <circle cx="700" cy="45" r="22" fill="#fff9c4"/>
  <circle cx="691" cy="39" r="22" fill="#0f2027" opacity="0.18"/>

  <!-- twinkling stars -->
  <g fill="#ffffff">
    <circle cx="60" cy="25" r="1.6"><animate attributeName="opacity" values="1;0.1;1" dur="2.4s" repeatCount="indefinite"/></circle>
    <circle cx="140" cy="60" r="1.2"><animate attributeName="opacity" values="0.2;1;0.2" dur="3s" repeatCount="indefinite"/></circle>
    <circle cx="220" cy="20" r="1.8"><animate attributeName="opacity" values="1;0.2;1" dur="2s" repeatCount="indefinite"/></circle>
    <circle cx="300" cy="85" r="1.3"><animate attributeName="opacity" values="0.3;1;0.3" dur="2.8s" repeatCount="indefinite"/></circle>
    <circle cx="380" cy="30" r="1.5"><animate attributeName="opacity" values="1;0.1;1" dur="3.2s" repeatCount="indefinite"/></circle>
    <circle cx="460" cy="105" r="1.2"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.2s" repeatCount="indefinite"/></circle>
    <circle cx="520" cy="40" r="1.7"><animate attributeName="opacity" values="1;0.3;1" dur="2.6s" repeatCount="indefinite"/></circle>
    <circle cx="590" cy="95" r="1.3"><animate attributeName="opacity" values="0.3;1;0.3" dur="3.4s" repeatCount="indefinite"/></circle>
    <circle cx="770" cy="110" r="1.4"><animate attributeName="opacity" values="1;0.2;1" dur="2.1s" repeatCount="indefinite"/></circle>
    <circle cx="25" cy="100" r="1.1"><animate attributeName="opacity" values="0.2;1;0.2" dur="2.9s" repeatCount="indefinite"/></circle>
  </g>

  <!-- flying bat (original silhouette) -->
  <g fill="#0b0b0f" stroke="#2c9cf0" stroke-width="0.8" stroke-linejoin="round">
    <animateMotion dur="10s" repeatCount="indefinite" path="M -70 75 C 100 15, 250 120, 400 60 S 700 20, 880 80"/>
    <!-- ears + body + head -->
    <polygon points="-5,-8 -3,-16 0,-9 3,-16 5,-8"/>
    <ellipse cx="0" cy="0" rx="6" ry="9"/>
    <!-- right wing -->
    <path d="M4 -2 C 20 -22 38 -20 52 -10 C 44 -8 40 -2 36 4 C 30 -2 22 -2 16 6 C 12 0 8 0 4 4 Z">
      <animate attributeName="d" dur="0.6s" repeatCount="indefinite"
        values="M4 -2 C 20 -22 38 -20 52 -10 C 44 -8 40 -2 36 4 C 30 -2 22 -2 16 6 C 12 0 8 0 4 4 Z;
                M4 -2 C 20 2 38 8 52 20 C 44 16 40 18 36 24 C 30 16 22 14 16 20 C 12 12 8 8 4 4 Z;
                M4 -2 C 20 -22 38 -20 52 -10 C 44 -8 40 -2 36 4 C 30 -2 22 -2 16 6 C 12 0 8 0 4 4 Z"/>
    </path>
    <!-- left wing -->
    <path d="M-4 -2 C -20 -22 -38 -20 -52 -10 C -44 -8 -40 -2 -36 4 C -30 -2 -22 -2 -16 6 C -12 0 -8 0 -4 4 Z">
      <animate attributeName="d" dur="0.6s" repeatCount="indefinite"
        values="M-4 -2 C -20 -22 -38 -20 -52 -10 C -44 -8 -40 -2 -36 4 C -30 -2 -22 -2 -16 6 C -12 0 -8 0 -4 4 Z;
                M-4 -2 C -20 2 -38 8 -52 20 C -44 16 -40 18 -36 24 C -30 16 -22 14 -16 20 C -12 12 -8 8 -4 4 Z;
                M-4 -2 C -20 -22 -38 -20 -52 -10 C -44 -8 -40 -2 -36 4 C -30 -2 -22 -2 -16 6 C -12 0 -8 0 -4 4 Z"/>
    </path>
  </g>
</svg>
